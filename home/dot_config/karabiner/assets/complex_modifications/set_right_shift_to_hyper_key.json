{
  "title": "Set Right Shift to Hyper Key",
  "rules": [
    {
      "description": "Set Right Shift to Hyper Key",
      "manipulators": [
        {
          "from": {
            "key_code": "right_shift",
            "modifiers": { "optional": ["any"] }
          },
          "to": [
            {
              "key_code": "right_shift",
              "modifiers": ["left_shift", "left_command", "left_control", "left_option"]
            }
          ],
          "type": "basic"
        }
      ]
    }
  ]
}
